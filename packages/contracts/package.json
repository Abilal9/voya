{
  "name": "@voya/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod contracts for the Voya API and its clients. No NestJS, Prisma or React Native imports.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jest": "29.5.14",
    "eslint": "^9.17.0",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.18.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ]
  }
}
