{
  "name": "voya",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "mobile": "pnpm --filter @voya/mobile",
    "api": "pnpm --filter @voya/api",
    "start": "pnpm --filter @voya/mobile start",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "pnpm -r --workspace-concurrency=1 lint",
    "test": "pnpm -r --workspace-concurrency=1 test"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "supabase", "@nestjs/core"]
  }
}
