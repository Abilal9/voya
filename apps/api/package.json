{
  "name": "@voya/api",
  "version": "0.1.0",
  "private": true,
  "description": "Voya API: NestJS modular monolith over Supabase PostgreSQL (Prisma) and Supabase Auth.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm --filter @voya/contracts build && prisma generate && nest build -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "pnpm --filter @voya/contracts build && nest start --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:integration": "jest --config test/jest-integration.json --runInBand",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/db-guard.mjs local && prisma migrate dev",
    "db:deploy": "node scripts/db-guard.mjs deploy && prisma migrate deploy",
    "db:seed": "node scripts/db-guard.mjs local && pnpm --filter @voya/contracts build && prisma db seed",
    "db:reset": "node scripts/db-guard.mjs local && pnpm --filter @voya/contracts build && prisma migrate reset --force",
    "db:status": "prisma migrate status",
    "supabase": "supabase",
    "supabase:start": "node scripts/ensure-signing-key.mjs && supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "start:local": "pnpm --filter @voya/contracts build && nest build -p tsconfig.build.json && node dist/main.js",
    "smoke:staging": "node scripts/staging-smoke.mjs"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "~6.19.0",
    "@voya/contracts": "workspace:*",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prisma": "~6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "jest": "~29.7.0",
    "pino-pretty": "^13.0.0",
    "supabase": "^2.62.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.18.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "<rootDir>/test/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@voya/contracts$": "<rootDir>/../../packages/contracts/src"
    }
  }
}
