# Voya API environment. Copy to `.env` for local development:
#   cp apps/api/.env.example apps/api/.env
# Every value below is a SAFE LOCAL DEFAULT for the Supabase CLI stack
# (`pnpm --filter @voya/api supabase:start`). Nothing here is a secret.
# Staging/production values live only in the host's secret store (Railway).
# The one server-only key (SUPABASE_SECRET_KEY, for avatar storage) is left
# blank here: copy the local stack's value from `supabase status`.

NODE_ENV=development
APP_ENV=local
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
LOG_PRETTY=true

# Runtime connection (hosted: the Supabase pooler, port 6543, ?pgbouncer=true).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct connection for Prisma Migrate (hosted: port 5432, never the pooler).
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth. The API verifies access tokens against the public JWKS at
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json (ES256); it holds no secret.
SUPABASE_URL=http://127.0.0.1:54321
# Optional overrides (derived from SUPABASE_URL when unset):
# SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
# SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Server-only Supabase secret key, used for Storage (signed avatar URLs) only.
# Local: `pnpm --filter @voya/api supabase status` → SECRET_KEY (sb_secret_…).
# Without it the API runs, but profile photos report "not available".
# Never commit a real value; never give it to the app.
SUPABASE_SECRET_KEY=
# Signed avatar download URL lifetime (seconds).
AVATAR_URL_TTL_SECONDS=43200

# Comma-separated browser origins (the future admin panel). Native apps are unaffected.
CORS_ORIGINS=
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=10000
