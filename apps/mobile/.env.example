# Voya mobile — development configuration (Expo inlines EXPO_PUBLIC_* at build time).
# Copy to `.env.local` (gitignored), or generate it from the running local stack:
#   pnpm --filter @voya/mobile env:local
#
# Everything here is PUBLIC by design: the app only ever holds Supabase's
# publishable (anon) key. Never put a secret / service-role key in the app.

# Auth provider in development: `mock` (default — fixtures, seeded users,
# code 424242) or `supabase` (real Supabase Auth + the Voya API).
# Non-development builds are always `supabase`.
EXPO_PUBLIC_VOYA_AUTH=supabase

# The local stack's publishable key: `pnpm --filter @voya/api supabase status` → PUBLISHABLE_KEY.
EXPO_PUBLIC_SUPABASE_KEY=

# Optional. In development these default to the machine running Metro
# (Simulator: localhost, Android Emulator: 10.0.2.2, phone on Wi-Fi: the
# Mac's LAN address), ports 54321 (Supabase) and 3000 (API). Set them for
# staging, e.g. https://<ref>.supabase.co and https://api-staging.example.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_API_URL=
